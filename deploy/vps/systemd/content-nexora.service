[Unit]
Description=Nexora Content API and player (Content-Nexora)
After=network.target

[Service]
Type=simple
User=nexora
WorkingDirectory=/opt/nexora/content-nexora
Environment=PYTHONUNBUFFERED=1
Environment=AUTOFLIX_HOST=127.0.0.1
Environment=AUTOFLIX_PORT=8787
Environment=AUTOFLIX_CORS_MODE=nginx
ExecStart=/opt/nexora/content-nexora/.venv/bin/gunicorn --bind 127.0.0.1:8787 --workers 3 --worker-class sync --timeout 30 --graceful-timeout 5 --access-logfile - --error-logfile - autoflix_api.app:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
