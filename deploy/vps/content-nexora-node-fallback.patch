+def absolute_url(value: Any) -> str:
+    raw = str(value or "").strip()
+    if raw.startswith("//"):
+        return f"https:{raw}"
+    if raw.startswith("/"):
+        return f"{base_url()}{raw}"
+    return raw
+
+
 def configured() -> bool:
     return bool(base_url())
 
