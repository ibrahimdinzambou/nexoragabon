     content["streamAvailable"] = True
     return content
 
+
+def _node_only_content(provider_name: str) -> dict[str, Any]:
+    """Return Node streams even when the Python provider search misses the title."""
+    tmdb_id = request.args.get("tmdbId", "").strip()
+    if not tmdb_id or not node_providers.configured():
+        raise ValueError("No Content-Nexora result and no Node fallback is configured")
+    raw_media_type = (request.args.get("mediaType") or request.args.get("type") or "movie").lower()
+    media_type = "series" if raw_media_type in {"series", "tv"} else "movie"
+    title = (request.args.get("q") or request.args.get("title") or f"TMDB {tmdb_id}").strip()
+    content = {
+        "id": f"content-nexora~node~{media_type}~{tmdb_id}",
+        "type": media_type,
+        "name": title,
+        "title": title,
+        "provider": provider_name,
+        "source": "french-nexora-node",
+        "players": [],
+        "sources": [],
+        "streamAvailable": False,
+    }
+    if media_type == "series":
+        season_number = int(request.args.get("season", "1") or 1)
+        content["seasons"] = [{
+            "season": season_number,
+            "season_number": season_number,
+            "title": f"Saison {season_number}",
+            "episodes": {},
+        }]
+    return _merge_node_sources(content)
+
+
+def _has_node_sources(content: dict[str, Any]) -> bool:
+    if content.get("streamAvailable"):
+        return True
+    for key in ("players", "sources", "streams", "nodeStreams", "frenchNexoraStreams"):
+        value = content.get(key)
+        if isinstance(value, list) and value:
+            return True
+    for season in content.get("seasons", []) or []:
+        for episodes in (season.get("episodes", {}) or {}).values():
+            if any((episode.get("players") or episode.get("sources")) for episode in episodes or []):
+                return True
+    return False
+
 
