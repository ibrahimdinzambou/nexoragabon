+const $ = (selector) => document.querySelector(selector);
+const provider = $("#provider"), query = $("#query"), results = $("#results");
+const message = $("#message"), video = $("#video"), embed = $("#embed");
+const empty = $("#screen-empty"), playerUrl = $("#player-url"), quality = $("#quality");
+const launchParams = new URLSearchParams(window.location.search);
+let hlsPlayer = null;
+let selectedReferer = "https://nexoragabon.com/";
+
+async function api(url, options) {
+  const response = await fetch(url, options);
+  const data = await response.json();
+  if (!response.ok) {
+    const error = new Error(data.error || "Erreur API");
+    error.status = response.status;
+    throw error;
+  }
+  return data;
+}
+
+function setMessage(text, error = false) {
+  message.textContent = text;
+  message.style.color = error ? "var(--orange)" : "var(--muted)";
+}
+
+function resultCard(title, detail, onClick) {
+  const card = document.createElement("button");
+  const heading = document.createElement("strong");
+  const description = document.createElement("small");
+  card.type = "button";
+  card.className = "result";
+  heading.textContent = title;
+  description.textContent = detail;
+  card.append(heading, description);
+  card.addEventListener("click", onClick);
+  return card;
+}
+
+function clearPlayback() {
+  if (hlsPlayer) hlsPlayer.destroy();
+  hlsPlayer = null;
+  video.pause();
+  video.removeAttribute("src");
+  video.load();
+  video.classList.remove("active");
+  embed.hidden = true;
+  embed.src = "about:blank";
+  empty.hidden = false;
+  quality.replaceChildren(new Option("AUTO", "-1"));
+  quality.disabled = true;
+}
+
+function resolvedLink(url, label) {
+  const link = document.createElement("a");
+  link.href = url;
+  link.target = "_blank";
+  link.rel = "noopener noreferrer";
+  link.textContent = "ouvrir dans un nouvel onglet ↗";
+  $("#resolved").replaceChildren(document.createTextNode(`${label} : `), link);
+}
+
+async function loadProviders() {
+  const data = await api("/api/providers");
+  provider.replaceChildren(...data.providers.map((entry) => new Option(entry.label, entry.id)));
+}
+
+async function selectResult(item) {
+  playerUrl.value = "";
+  $("#now-playing").textContent = item.title || "Source sélectionnée";
+  if (!item.url) return;
+  selectedReferer = item.url;
+  setMessage("Chargement des lecteurs…");
+  try {
+    const data = await api(`/api/content?provider=${encodeURIComponent(provider.value)}&url=${encodeURIComponent(item.url)}`);
+    const content = data.content;
+    selectedReferer = content?.url || item.url;
+    if (content.type === "movie") return renderPlayers(content.players);
+    if (content.type === "series") return renderSeasons(content);
+    if (content.type === "season") return renderEpisodes(content.episodes);
+    setMessage("Type de contenu non reconnu.", true);
+  } catch (error) { setMessage(error.message, true); }
+}
+
+function renderPlayers(players) {
