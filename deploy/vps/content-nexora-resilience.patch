+    """Only let the resolver contact a hostname declared in the player registry."""
+    from urllib.parse import urlparse
+
+    hostname = (urlparse(url).hostname or "").lower()
+    if not hostname:
+        return False
+    labels = set(hostname.split("."))
+    for player_name in players:
+        token = player_name.lower().strip(".")
+        if "." in token and (hostname == token or hostname.endswith("." + token)):
+            return True
+        if token in labels:
+            return True
+    return False
