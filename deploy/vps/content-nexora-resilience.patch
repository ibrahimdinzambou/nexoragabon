+
+def request_cache_key(namespace: str) -> tuple[str, ...]:
+    return (namespace, *(f"{key}={value}" for key, value in sorted(request.args.items())))
+
+
+def cached_response(key: tuple[str, ...], ttl_seconds: int, loader):
+    """Avoid repeated scraper work and keep a stale value for upstream outages."""
+    now = time.monotonic()
+    with _response_cache_lock:
+        cached = _response_cache.get(key)
+        if cached and cached[0] > now:
+            return cached[2]
+
+    try:
+        value = loader()
+    except Exception:
+        with _response_cache_lock:
+            stale = _response_cache.get(key)
+            if stale and stale[1] > now:
+                app.logger.warning("Serving stale Content-Nexora response for %s", key[0])
+                return stale[2]
+        raise
+
+    with _response_cache_lock:
+        expired = [cache_key for cache_key, entry in _response_cache.items() if entry[1] <= now]
+        for cache_key in expired:
+            _response_cache.pop(cache_key, None)
+        while len(_response_cache) >= RESPONSE_CACHE_MAX_ENTRIES:
+            _response_cache.pop(next(iter(_response_cache)))
+        _response_cache[key] = (
+            now + ttl_seconds,
+            now + RESPONSE_CACHE_STALE_TTL_SECONDS,
+            value,
+        )
+    return value
+
@@ -281,0 +326,33 @@ def provider_or_error(name: str):
+def _safe_http_url(value: Any) -> str:
+    """Reject malformed URLs and local network targets before scraper requests."""
+    url = str(value or "").strip()
+    parsed = urlparse(url)
+    hostname = (parsed.hostname or "").lower().rstrip(".")
+    if parsed.scheme not in {"http", "https"} or not hostname or parsed.username or parsed.password:
+        raise ValueError("A valid public HTTP(S) URL is required")
+    if hostname == "localhost" or hostname.endswith((".local", ".localhost", ".internal")):
+        raise ValueError("Local network URLs are not allowed")
+    try:
+        address = ipaddress.ip_address(hostname)
+    except ValueError:
+        pass
+    else:
+        if not address.is_global:
+            raise ValueError("Private or local network URLs are not allowed")
+    return url
+
+
+def _provider_url(provider_name: str, value: Any) -> str:
+    """Only let a provider scraper open URLs on its own configured website."""
+    url = _safe_http_url(value)
+    provider = provider_or_error(provider_name)
+    module = provider["module"]
+    if provider_name.lower() == "anime-sama":
+        module.get_website_url()
+    expected = (urlparse(str(getattr(module, "website_origin", ""))).hostname or "").lower()
+    actual = (urlparse(url).hostname or "").lower()
+    if not expected or (actual != expected and not actual.endswith("." + expected)):
+        raise ValueError("The content URL does not belong to the selected provider")
+    return url
+
