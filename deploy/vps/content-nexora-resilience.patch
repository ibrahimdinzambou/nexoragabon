@@ -8,0 +10 @@ from pathlib import Path
+from threading import Lock
@@ -51,0 +54,41 @@ PROVIDERS = {
+RESPONSE_CACHE_MAX_ENTRIES = 128
+RESPONSE_CACHE_STALE_TTL_SECONDS = 15 * 60
+_response_cache: dict[tuple[str, ...], tuple[float, float, Any]] = {}
+_response_cache_lock = Lock()
+
+
+def request_cache_key(namespace: str) -> tuple[str, ...]:
+    return (namespace, *(f"{key}={value}" for key, value in sorted(request.args.items())))
+
+
+def cached_response(key: tuple[str, ...], ttl_seconds: int, loader):
+    """Avoid repeated scraper work and keep a stale value for upstream outages."""
+    now = time.monotonic()
+    with _response_cache_lock:
+        cached = _response_cache.get(key)
+        if cached and cached[0] > now:
+            return cached[2]
+
+    try:
+        value = loader()
+    except Exception:
+        with _response_cache_lock:
+            stale = _response_cache.get(key)
+            if stale and stale[1] > now:
+                app.logger.warning("Serving stale Content-Nexora response for %s", key[0])
+                return stale[2]
+        raise
+
+    with _response_cache_lock:
+        expired = [cache_key for cache_key, entry in _response_cache.items() if entry[1] <= now]
+        for cache_key in expired:
+            _response_cache.pop(cache_key, None)
+        while len(_response_cache) >= RESPONSE_CACHE_MAX_ENTRIES:
+            _response_cache.pop(next(iter(_response_cache)))
+        _response_cache[key] = (
+            now + ttl_seconds,
+            now + RESPONSE_CACHE_STALE_TTL_SECONDS,
+            value,
+        )
+    return value
+
