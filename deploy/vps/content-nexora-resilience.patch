+                    "bandwidth": int(variant.stream_info.bandwidth or 0),
+                })
+            result["qualities"] = sorted(
+                {item["height"]: item for item in qualities}.values(),
+                key=lambda item: item["height"],
+            )
+        return result
+    finally:
+        response.close()
+
