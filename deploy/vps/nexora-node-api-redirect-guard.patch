From 39bd7f25feaebf0c7a5b311d9f1bcd6c9ebdced6 Mon Sep 17 00:00:00 2001
From: ibrahimdinzambou <ibrahimdinzambou@users.noreply.github.com>
Date: Thu, 30 Jul 2026 22:56:32 +0100
Subject: [PATCH] Block external Puppeteer redirects

---
 src/lib/puppeteer.ts | 62 +++++++++++++++++++++++++++++++++++++-------
 1 file changed, 52 insertions(+), 10 deletions(-)

diff --git a/src/lib/puppeteer.ts b/src/lib/puppeteer.ts
index 2e8cdee..c26c40f 100644
--- a/src/lib/puppeteer.ts
+++ b/src/lib/puppeteer.ts
@@ -1,4 +1,4 @@
-import puppeteer, { Browser, Page } from 'puppeteer';
+import puppeteer, { Browser, HTTPRequest, Page } from 'puppeteer';
 
 let browser: Browser | null = null;
 
@@ -15,7 +15,7 @@ function hostnameMatches(hostname: string, allowedHost: string): boolean {
   return Boolean(allowed && (host === allowed || host.endsWith(`.${allowed}`)));
 }
 
-function isAllowedTopNavigation(value: string, allowedMainHosts: string[]): boolean {
+function isAllowedNavigation(value: string, allowedMainHosts: string[]): boolean {
   try {
     const url = new URL(value);
     if (!['http:', 'https:'].includes(url.protocol)) return true;
@@ -83,6 +83,20 @@ export async function preparePage(
     };
     // @ts-ignore
     window.open = () => null; // Bloque les pop-ups
+    document.addEventListener('click', (event) => {
+      const target = event.target as Element | null;
+      const anchor = target?.closest?.('a[href]') as HTMLAnchorElement | null;
+      if (!anchor || allowed(anchor.href)) return;
+      event.preventDefault();
+      event.stopImmediatePropagation();
+    }, true);
+    document.addEventListener('submit', (event) => {
+      const form = event.target as HTMLFormElement | null;
+      const action = form?.action || window.location.href;
+      if (allowed(action)) return;
+      event.preventDefault();
+      event.stopImmediatePropagation();
+    }, true);
     try {
       const assign = window.location.assign.bind(window.location);
       const replace = window.location.replace.bind(window.location);
@@ -116,23 +130,27 @@ export async function preparePage(
 
       // Bloque les pubs et trackers
       if (BAD_URL_RX.test(url)) {
-        return req.abort();
+        return abortRequest(req);
       }
 
       // Bloque les assets si demand?
       if (opts.blockAssets && ['image', 'font', 'stylesheet'].includes(req.resourceType())) {
-        return req.abort();
+        return abortRequest(req);
       }
 
-      // Contr?le les navigations principales
-      if (req.isNavigationRequest() && req.frame() === page.mainFrame()) {
-        if (!isAllowedTopNavigation(url, allowedMainHosts)) return req.abort();
+      // Controle toutes les navigations de frames, quel que soit le provider.
+      if (req.isNavigationRequest()) {
+        if (!isAllowedNavigation(url, allowedMainHosts)) return abortRequest(req);
       }
 
-      req.continue();
+      if (redirectedOutsideAllowedHosts(req, allowedMainHosts)) {
+        return abortRequest(req);
+      }
+
+      continueRequest(req);
     } catch {
       try {
-        req.continue();
+        continueRequest(req);
       } catch {}
     }
   });
@@ -150,12 +168,36 @@ export async function preparePage(
     try {
       if (frame !== page.mainFrame()) return;
       const url = frame.url();
-      if (url === 'about:blank' || isAllowedTopNavigation(url, allowedMainHosts)) return;
+      if (url === 'about:blank' || isAllowedNavigation(url, allowedMainHosts)) return;
       await page.goto('about:blank', { waitUntil: 'domcontentloaded', timeout: 3000 }).catch(() => {});
     } catch {}
   });
 }
 
+function requestAlreadyHandled(req: HTTPRequest): boolean {
+  try {
+    return req.isInterceptResolutionHandled();
+  } catch {
+    return false;
+  }
+}
+
+function abortRequest(req: HTTPRequest): void {
+  if (requestAlreadyHandled(req)) return;
+  void req.abort('blockedbyclient').catch(() => {});
+}
+
+function continueRequest(req: HTTPRequest): void {
+  if (requestAlreadyHandled(req)) return;
+  void req.continue().catch(() => {});
+}
+
+function redirectedOutsideAllowedHosts(req: HTTPRequest, allowedMainHosts: string[]): boolean {
+  const redirectChain = req.redirectChain();
+  if (!redirectChain.length) return false;
+  return !isAllowedNavigation(req.url(), allowedMainHosts);
+}
+
 export function attachCollector(page: Page) {
   const store = {
     embeds: new Set<string>(),
-- 
