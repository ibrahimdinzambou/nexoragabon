@@ -5,0 +6,26 @@ const BAD_URL_RX = /(doubleclick|googlesyndication|googletagmanager|google-analy
+const NEXORA_NAVIGATION_HOSTS = ['nexoragabon.com', 'www.nexoragabon.com'] as const;
+
+function normalizeHost(value: string): string {
+  return String(value || '').trim().toLowerCase().replace(/^https?:\/\//, '').replace(/\/.*$/, '');
+}
+
+function hostnameMatches(hostname: string, allowedHost: string): boolean {
+  const host = normalizeHost(hostname);
+  const allowed = normalizeHost(allowedHost);
+  if (!allowed) return false;
+  if ((NEXORA_NAVIGATION_HOSTS as readonly string[]).includes(allowed)) {
+    return host === allowed;
+  }
+  return host === allowed || host.endsWith(`.${allowed}`);
+}
+
+function isAllowedTopNavigation(value: string, allowedMainHosts: string[]): boolean {
+  try {
+    const url = new URL(value);
+    if (!['http:', 'https:'].includes(url.protocol)) return true;
+    const allowedHosts = [...NEXORA_NAVIGATION_HOSTS, ...allowedMainHosts].map(normalizeHost).filter(Boolean);
+    return allowedHosts.some((host) => hostnameMatches(url.hostname, host));
+  } catch {
+    return false;
+  }
+}
