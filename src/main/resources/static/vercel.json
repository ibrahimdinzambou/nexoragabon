{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "navigate-to 'self' https://nexoragabon.com https://www.nexoragabon.com; form-action 'self' https://nexoragabon.com https://www.nexoragabon.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.nexoragabon.com/api/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "https://api.nexoragabon.com/actuator/:path*"
    }
  ]
}
